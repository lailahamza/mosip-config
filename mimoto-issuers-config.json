{
  "issuers": [
    {
      "credential_issuer": "Mock",
      "display": [
        {
          "name": "MOCK ID LHOUSSINE",
          "logo": {
            "url": "https://mosip.io/images/mosipn-logo.png",
            "alt_text": "mosip-logo"
          },
          "title": "Download MOSIP Credentials",
          "description": "Download credentials by providing UIN or VID",
          "language": "en"
        },
        {
          "name": "MOCK ID",
          "logo": {
            "url": "https://mosip.io/images/mosipn-logo.png",
            "alt_text": "شعار موسيب"
          },
          "title": "قم بتنزيل بيانات اعتماد MOSIP",
          "description": "توفير UIN أو VIDقم بتنزيل بيانات الاعتماد عن طريق" ,
          "language": "ar"
        }
      ],
  	  "protocol": "OpenId4VCI",
  	  "client_id": "${mimoto.oidc.partner.clientid}",
  	  "client_alias": "mpartner-default-mimotooidc",
  	  "scopes_supported": ["mosip_identity_vc_ldp"],
  	  "additional_headers": { "Accept": "application/json" },
  	  ".well-known": "https://esignet.mosip.ma/v1/esignet/vci/.well-known/openid-credential-issuer?version=v11",
  	  "redirect_uri": "io.mosip.residentapp.inji://oauthredirect",
  	  "authorization_endpoint": "https://esignet.mosip.ma/authorize",
  	  "authorization_audience": "https://esignet.mosip.ma/v1/esignet/oauth/v2/token",
  	  "token_endpoint": "https://api.mosip.ma/v1/mimoto/get-token/Mock",
  	  "proxy_token_endpoint": "https://esignet.mosip.ma/v1/esignet/oauth/v2/token",
  	  "credential_endpoint": "https://esignet.mosip.ma/v1/esignet/vci/credential",
  	  "credential_type": ["SampleVerifiableCredential"],
  	  "credential_audience": "https://esignet.mosip.ma/v1/esignet",
  	  "enabled": "true",
      "qr_code_type": "EmbeddedVC",
      "wellknown_endpoint": "https://inji.mosip.ma/v1/certify/issuance/.well-known/openid-credential-issuer"
    }   
  ]
}
